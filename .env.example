# X Developer Console → your app → Keys and tokens (OAuth 2.0)
X_CLIENT_ID=
# Only for confidential app types (Web App / Automated App). Leave empty for Native App (PKCE).
X_CLIENT_SECRET=
# Must be registered on the app. Use 127.0.0.1, not localhost.
X_REDIRECT_URI=http://127.0.0.1:8477/callback

# Guardrails (this file is read from ~/.x-mcp/.env — not from the current directory)
X_MCP_MONTHLY_BUDGET_USD=25
X_MCP_REQUIRE_APPROVAL=true
X_MCP_MIN_HOURS_BETWEEN_ORIGINALS=4
X_MCP_MAX_REPLIES_PER_HOUR=12
X_MCP_MAX_REPOSTS_PER_DAY=10
X_MCP_MAX_DMS_PER_HOUR=5
X_MCP_MAX_READS_PER_CALL=100
# Directories the agent may upload media from (comma-separated). Default: ~/.x-mcp/media
# X_MCP_MEDIA_ROOT=~/.x-mcp/media,~/Movies/x-demos
# X_MCP_STATE_DIR=~/.x-mcp
# X_MCP_FFPROBE=/opt/homebrew/bin/ffprobe
